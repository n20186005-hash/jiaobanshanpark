---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import Icon from '@/components/Icon.astro';
import GoogleReviews from '@/components/GoogleReviews.astro';
import SourcesSection from '@/components/SourcesSection.astro';
import WeatherWidget from '@/components/WeatherWidget.astro';
import VisitorServices from '@/components/VisitorServices.astro';
import SeasonalStrategy from '@/components/SeasonalStrategy.astro';
import AudienceRoutes from '@/components/AudienceRoutes.astro';
import VisitorResponsibility from '@/components/VisitorResponsibility.astro';
import { attractions, routes, faqs, photoCredits, entity, googleReview } from '@/data/site';

const title = '角板山公園攻略｜免費入園・梅花季・戰備隧道・交通門票（桃園市復興區）';
const description =
  '桃園復興角板山公園（角板山行館）旅遊指南：常態免費入園，整理冬季梅花季、戰備隧道彩繪展、開放時間、公車交通與周邊停車資訊，並附即時天氣與三條遊園路線。';
const ogTitle = '角板山公園 Jiaobanshan Park（桃園市復興區）- Travel Guide';
const ogDescription = 'Official visitor guide to Jiaobanshan Park (角板山公園) in Fuxing District, Taoyuan City, Taiwan：行館、梅園、戰備隧道、思親亭、交通與停車指南。';
const mapUrl = 'https://www.google.com/maps/dir/?api=1&destination=24.813974%2C121.3506816&destination_place_id=ChIJr2I-r9MWaDQRiHCNvgk5XjM';

const touristSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Park'],
  '@id': 'https://JiaobanshanPark.com/#attraction',
  name: '角板山公園',
  alternateName: ['Jiaobanshan Park', '角板山', '復興區 角板山公園', 'Jiaobanshan Park Fuxing'],
  description,
  url: 'https://JiaobanshanPark.com/',
  image: [
    'https://JiaobanshanPark.com/images/jiaobanshan-park-og-1.jpg',
    'https://JiaobanshanPark.com/images/jiaobanshan-park-resort-1.jpg',
    'https://JiaobanshanPark.com/images/jiaobanshan-park-plum-1.jpg',
  ],
  isAccessibleForFree: true,
  openingHours: 'Mo-Su 09:00-20:00',
  telephone: entity.telephone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: entity.streetAddress,
    addressLocality: entity.city,
    addressRegion: entity.stateProvince,
    postalCode: entity.postalCode,
    addressCountry: entity.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: entity.latitude,
    longitude: entity.longitude,
  },
  hasMap: entity.mapsShareUrl,
  sameAs: [entity.mapsShareUrl, entity.govtTourismUrl],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: googleReview.rating,
    reviewCount: googleReview.ratingCount,
    bestRating: googleReview.ratingScale,
    worstRating: 1,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '台灣', item: 'https://JiaobanshanPark.com/' },
    { '@type': 'ListItem', position: 2, name: '桃園市', item: 'https://JiaobanshanPark.com/' },
    { '@type': 'ListItem', position: 3, name: '復興區', item: 'https://JiaobanshanPark.com/' },
    { '@type': 'ListItem', position: 4, name: '角板山公園', item: 'https://JiaobanshanPark.com/' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout {title} {description} {ogTitle} {ogDescription}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(touristSchema)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <link
      {...{
        rel: 'preload',
        as: 'image',
        href: '/images/jiaobanshan-park-plum-1-1440.avif',
        type: 'image/avif',
        imagesrcset:
          '/images/jiaobanshan-park-plum-1-480.avif 480w, /images/jiaobanshan-park-plum-1-768.avif 768w, /images/jiaobanshan-park-plum-1-960.avif 960w, /images/jiaobanshan-park-plum-1-1440.avif 1440w, /images/jiaobanshan-park-plum-1-1920.avif 1920w',
        imagesizes: '100vw',
        fetchpriority: 'high',
      } as Record<string, string>}
    />
  </Fragment>

  <header class="glass-header fixed inset-x-0 top-0 z-50 border-b border-forest-950/8">
    <div class="container-shell flex h-[var(--header-height)] items-center justify-between gap-5">
      <a href="#top" class="group flex items-center gap-3" aria-label="角板山公園首頁">
        <img src="/favicon.svg" alt="" width="40" height="40" class="size-10 rounded-full transition-transform group-hover:-rotate-3" />
        <span class="leading-tight">
          <span class="block font-serif text-lg font-bold tracking-tight text-forest-900">角板山公園</span>
          <span class="block text-[0.6rem] font-bold tracking-[0.22em] text-plum-600">JIAOBANSHAN PARK</span>
        </span>
      </a>

      <nav class="hidden items-center gap-7 lg:flex" aria-label="主要導覽">
        <a class="nav-link" href="#highlights">必看景點</a>
        <a class="nav-link" href="#routes">遊園路線</a>
        <a class="nav-link" href="#seasons">四季風景</a>
        <a class="nav-link" href="#weather">天氣預報</a>
        <a class="nav-link" href="#transport">交通停車</a>
        <a class="nav-link" href="#reviews">旅客評價</a>
        <a class="nav-link" href="#faq">常見問題</a>
      </nav>

      <div class="hidden items-center gap-3 md:flex">
        <a
          href={mapUrl}
          target="_blank"
          rel="nofollow noopener"
          class="inline-flex h-11 items-center gap-2 rounded-full bg-forest-900 px-5 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-forest-800"
        >
          <Icon name="map-pin" class="size-4" />
          開始導航
        </a>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="grid size-11 place-items-center rounded-full border border-forest-900/15 text-forest-900 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="開啟選單"
      >
        <span class="menu-open"><Icon name="menu" class="size-5" /></span>
        <span class="menu-close hidden"><Icon name="close" class="size-5" /></span>
      </button>
    </div>

    <nav id="mobile-menu" class="hidden border-t border-forest-950/8 bg-cream-50 px-4 py-4 lg:hidden" aria-label="行動版導覽">
      <div class="container-shell grid gap-1">
        <a class="rounded-xl px-3 py-3 font-semibold text-forest-900 hover:bg-forest-50" href="#highlights">必看景點</a>
        <a class="rounded-xl px-3 py-3 font-semibold text-forest-900 hover:bg-forest-50" href="#routes">遊園路線</a>
        <a class="rounded-xl px-3 py-3 font-semibold text-forest-900 hover:bg-forest-50" href="#seasons">四季風景</a>
        <a class="rounded-xl px-3 py-3 font-semibold text-forest-900 hover:bg-forest-50" href="#weather">天氣預報</a>
        <a class="rounded-xl px-3 py-3 font-semibold text-forest-900 hover:bg-forest-50" href="#transport">交通停車</a>
        <a class="rounded-xl px-3 py-3 font-semibold text-forest-900 hover:bg-forest-50" href="#reviews">旅客評價</a>
        <a class="rounded-xl px-3 py-3 font-semibold text-forest-900 hover:bg-forest-50" href="#faq">常見問題</a>
      </div>
    </nav>
  </header>

  <main id="main-content">
    <section id="top" class="hero-noise relative min-h-[43rem] overflow-hidden bg-forest-950 pt-[var(--header-height)] text-white md:min-h-[50rem]">
      <div class="absolute inset-0 top-[var(--header-height)]">
        <ResponsiveImage
          name="jiaobanshan-park-plum-1"
          alt="角板山梅園、大漢溪與山谷風景"
          width={2400}
          height={1800}
          class="h-full w-full object-cover"
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          wide={true}
          position="58% 52%"
        />
        <div class="hero-mask absolute inset-0"></div>
        <div class="hero-contours absolute inset-0" aria-hidden="true"></div>
      </div>

      <div class="container-shell relative flex min-h-[calc(43rem-var(--header-height))] items-end pb-14 pt-24 md:min-h-[calc(50rem-var(--header-height))] md:pb-20">
        <div class="max-w-4xl">
          <p class="mb-7 flex items-center gap-3 text-xs font-bold tracking-[0.24em] text-cream-200/85 md:text-sm">
            <span class="h-px w-9 bg-plum-300"></span>
            桃園・復興・北橫山城
          </p>
          <h1 class="hero-title max-w-[11ch] text-cream-50">
            <span class="small">JIAOBANSHAN PARK</span>
            走進<br />角板山公園
          </h1>
          <p class="mt-8 max-w-2xl text-base leading-8 text-cream-100/90 md:text-xl md:leading-9">
            在梅香、松林與山谷之間，走過歷史行館、戰備隧道與思親亭。這裡不只是一座公園，而是一段適合慢慢閱讀的北橫旅程。
          </p>
          <p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-cream-200/75">
            <span class="font-semibold text-cream-100">{entity.country}</span>
            <span class="text-cream-200/50">›</span>
            <span class="font-semibold text-cream-100">{entity.stateProvince}</span>
            <span class="text-cream-200/50">›</span>
            <span class="font-semibold text-cream-100">{entity.city}</span>
            <span class="text-cream-200/50">›</span>
            <span class="font-semibold text-cream-100">角板山公園</span>
            <span class="ml-1 rounded-full bg-white/10 px-2.5 py-0.5 text-xs tracking-wide text-cream-200">{entity.fullNameEn}，{entity.stateProvinceEn}，{entity.countryEn}</span>
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="#routes" class="primary-btn">
              選擇遊園路線
              <Icon name="arrow-right" class="size-4" />
            </a>
            <a href="#visit-info" class="secondary-btn">
              先看行前資訊
            </a>
          </div>
        </div>
      </div>

    </section>

    <section id="visit-info" class="visit-ribbon relative z-10 border-b border-stonewarm-200 bg-cream-100 pb-7 pt-6 md:pt-9">
      <div class="visit-card container-shell grid gap-0 sm:grid-cols-2 lg:grid-cols-5">
        <div class="season-fact visit-fact flex items-center gap-3">
          <span class="grid size-10 shrink-0 place-items-center rounded-full bg-plum-100 text-plum-600"><Icon name="camera" class="size-5" /></span>
          <div>
            <p class="text-[0.66rem] font-bold tracking-[0.16em] text-plum-600">BEST SEASON</p>
            <p class="mt-1 font-serif text-lg font-bold leading-6 text-forest-900">冬日賞梅</p>
            <p class="mt-0.5 text-xs text-stonewarm-500">四季皆宜散步</p>
          </div>
        </div>
        <div class="fact-card visit-fact flex items-center gap-3">
          <Icon name="ticket" class="mt-0.5 size-5 shrink-0 text-plum-600" />
          <div><p class="text-xs font-bold tracking-[0.12em] text-stonewarm-500">門票</p><p class="mt-1 font-bold text-forest-900">常態免費參觀</p></div>
        </div>
        <div class="fact-card visit-fact flex items-center gap-3">
          <Icon name="clock" class="mt-0.5 size-5 shrink-0 text-plum-600" />
          <div><p class="text-xs font-bold tracking-[0.12em] text-stonewarm-500">建議停留</p><p class="mt-1 font-bold text-forest-900">完整約 2–3 小時</p></div>
        </div>
        <div class="fact-card visit-fact flex items-center gap-3">
          <Icon name="map-pin" class="mt-0.5 size-5 shrink-0 text-plum-600" />
          <div><p class="text-xs font-bold tracking-[0.12em] text-stonewarm-500">位置</p><p class="mt-1 font-bold text-forest-900">桃園市復興區</p></div>
        </div>
        <div class="fact-card visit-fact flex items-center gap-3">
          <Icon name="clock" class="mt-0.5 size-5 shrink-0 text-plum-600" />
          <div><p class="text-xs font-bold tracking-[0.12em] text-stonewarm-500">常態時間</p><p class="mt-1 font-bold text-forest-900">室內 09:00–17:00</p><p class="mt-0.5 text-xs text-stonewarm-500">戶外園區至 20:00</p></div>
        </div>
      </div>
      <div class="container-shell pt-5">
        <p class="flex items-start gap-2 text-sm leading-6 text-stonewarm-500">
          <Icon name="info" class="mt-0.5 size-4 shrink-0" />
          山區可能因颱風、豪雨、施工或活動調整開放，出發前請再確認現場公告。
        </p>
      </div>
    </section>

    <WeatherWidget />

    <section class="section-pad overflow-hidden bg-cream-50">
      <div class="container-shell grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <div class="reveal">
          <p class="eyebrow">WHY JIAOBANSHAN</p>
          <h2 class="section-title">一座公園，讀懂山城的多重風景</h2>
          <p class="section-lead mt-7">
            歡迎來到角板山公園（<span class="font-semibold text-forest-900">Jiaobanshan Park</span>）——位於{entity.country}{entity.stateProvince}{entity.city}澤仁里的山林公園，也是認識北橫山城最重要的核心景點之一。以語意來說，角板山公園（Jiaobanshan Park）與角板山行館園區常被視為同一片核心遊憩範圍。
          </p>
          <p class="section-lead mt-4">
            角板山的魅力不只在梅花。行館留下時代記憶，樟腦收納所連結山地產業，戰備隧道藏進林下，思親亭則把視線帶向大漢溪與溪口台地。
          </p>
          <p class="section-lead mt-4">
            即使不是花季，老樹、草地、戶外雕塑與山谷氣候，仍足以構成一趟舒服的半日散步。
          </p>
          <p class="mt-5 inline-flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-stonewarm-500">
            <span class="font-semibold text-forest-800">角板山公園</span>
            <span>›</span>
            <span class="font-semibold text-forest-800">{entity.city}</span>
            <span>›</span>
            <span class="font-semibold text-forest-800">{entity.stateProvince}</span>
            <span>›</span>
            <span class="font-semibold text-forest-800">{entity.country}</span>
          </p>
          <div class="mt-8 grid grid-cols-2 gap-5 border-t border-stonewarm-200 pt-7 sm:grid-cols-3">
            <div><p class="font-serif text-3xl font-bold text-forest-900">6+</p><p class="mt-1 text-sm text-stonewarm-500">主題景點</p></div>
            <div><p class="font-serif text-3xl font-bold text-forest-900">3</p><p class="mt-1 text-sm text-stonewarm-500">推薦路線</p></div>
            <div><p class="font-serif text-3xl font-bold text-forest-900">四季</p><p class="mt-1 text-sm text-stonewarm-500">都能散步</p></div>
          </div>
        </div>

        <div class="relative reveal">
          <div class="photo-card aspect-[4/3]">
            <ResponsiveImage
              name="jiaobanshan-park-resort-1"
              alt="樹蔭環繞的角板山行館"
              width={960}
              height={640}
              class="h-full w-full object-cover"
              position="50% 55%"
            />
          </div>
          <div class="absolute -bottom-6 -left-3 max-w-[14rem] rounded-2xl border border-white/60 bg-white/90 p-4 shadow-xl backdrop-blur md:-left-8 md:p-5">
            <div class="flex items-center gap-3">
              <span class="grid size-10 place-items-center rounded-full bg-forest-100 text-forest-700"><Icon name="leaf" class="size-5" /></span>
              <div><p class="text-xs font-bold tracking-[0.1em] text-plum-600">慢遊提示</p><p class="mt-1 text-sm font-bold leading-5 text-forest-900">不要只拍梅花，留時間看山谷。</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="highlights" class="mountain-section section-pad bg-forest-950 text-white">
      <div class="container-shell">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div class="reveal">
            <p class="eyebrow !text-plum-300">PARK HIGHLIGHTS</p>
            <h2 class="section-title !text-cream-50">六個停留點，拼出完整的角板山</h2>
          </div>
          <p class="max-w-2xl text-base leading-8 text-cream-200/75 lg:justify-self-end lg:text-lg">
            從建築走向山谷、從地面走入隧道。每個景點都不大，但串在一起，才是角板山真正值得停留的原因。
          </p>
        </div>

        <div class="mt-14 space-y-12 md:mt-20 md:space-y-20">
          {attractions.map((item, index) => (
            <article id={item.id} class={`reveal grid items-center gap-8 lg:grid-cols-2 lg:gap-16 ${index % 2 === 1 ? 'lg:[&>.image-wrap]:order-2' : ''}`}>
              <div class="image-wrap photo-card aspect-[4/3] bg-forest-900">
                <ResponsiveImage
                  name={item.image}
                  alt={item.alt}
                  width={item.imageWidth}
                  height={item.imageHeight}
                  class="h-full w-full object-cover"
                  position={item.position}
                />
                <span class="absolute left-5 top-5 rounded-full bg-forest-950/72 px-3 py-1.5 text-xs font-bold tracking-[0.12em] text-cream-100 backdrop-blur">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>
              <div class={index % 2 === 1 ? 'lg:pr-8' : 'lg:pl-2'}>
                <p class="text-xs font-bold tracking-[0.18em] text-plum-300">{item.eyebrow}</p>
                <h3 class="mt-3 font-serif text-3xl font-bold tracking-tight text-cream-50 md:text-5xl">{item.name}</h3>
                <p class="mt-5 text-base leading-8 text-cream-200/78 md:text-lg">{item.description}</p>
                <div class="mt-7 flex flex-wrap gap-3">
                  <span class="inline-flex items-center gap-2 rounded-full border border-cream-100/16 bg-white/5 px-4 py-2 text-sm text-cream-100/80">
                    <Icon name="clock" class="size-4 text-plum-300" />{item.duration}
                  </span>
                  <span class="inline-flex items-center gap-2 rounded-full border border-cream-100/16 bg-white/5 px-4 py-2 text-sm text-cream-100/80">
                    <Icon name="camera" class="size-4 text-plum-300" />適合慢慢拍
                  </span>
                </div>
                <p class="mt-6 border-l border-plum-400 pl-4 text-sm leading-7 text-cream-200/65">{item.tip}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="routes" class="paper-section section-pad bg-cream-100">
      <div class="container-shell">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <div class="reveal">
            <p class="eyebrow">ROUTE PLANNER</p>
            <h2 class="section-title">依照體力與時間，選一條剛好的路</h2>
          </div>
          <p class="section-lead lg:justify-self-end">
            園區不是完全平坦。與其追求「全部走完」，不如先決定停留時間，再把最想看的景點排在前面。
          </p>
        </div>

        <div class="mt-12 grid gap-7 lg:grid-cols-[0.7fr_1.3fr] lg:gap-12">
          <div class="reveal">
            <div class="flex flex-col gap-3" role="tablist" aria-label="遊園路線">
              {routes.map((route, index) => (
                <button
                  type="button"
                  class="route-tab flex items-center justify-between rounded-2xl px-5 py-4 text-left"
                  role="tab"
                  id={`route-tab-${route.id}`}
                  aria-controls={`route-panel-${route.id}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? '0' : '-1'}
                  data-route-tab={route.id}
                >
                  <span><span class="block font-bold">{route.title}</span><span class="mt-1 block text-sm opacity-70">{route.audience}</span></span>
                  <span class="rounded-full border border-current/20 px-3 py-1 text-xs font-bold">{route.duration}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="reveal rounded-[2rem] bg-white p-6 shadow-[0_25px_80px_rgba(23,55,45,0.08)] md:p-9">
            {routes.map((route, index) => (
              <div
                id={`route-panel-${route.id}`}
                role="tabpanel"
                aria-labelledby={`route-tab-${route.id}`}
                hidden={index !== 0}
                data-route-panel={route.id}
              >
                <div class="flex flex-col gap-5 border-b border-stonewarm-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
                  <div>
                    <p class="text-xs font-bold tracking-[0.16em] text-plum-600">{route.audience}</p>
                    <h3 class="mt-2 font-serif text-3xl font-bold text-forest-900 md:text-4xl">{route.title}</h3>
                  </div>
