---
import SubpageLayout from '@/layouts/SubpageLayout.astro';
import { photoCredits } from '@/data/site';
---

<SubpageLayout
  title="實景照片來源"
  description="角板山公園旅遊指南現有實景照片的來源索引與原作者資料。"
  canonical="https://JiaobanshanPark.com/image-credits/"
  breadcrumb={[{ name: '實景照片來源', path: '/image-credits/' }]}
>
  <section class="section-pad bg-cream-100">
    <div class="container-shell max-w-5xl">
      <p class="eyebrow">PHOTO SOURCES</p>
      <h1 class="section-title mt-3">實景照片來源與說明</h1>
      <p class="section-lead mt-5">本網站展示的圖片產權及版權歸原攝影者所有。以下保留原先首頁列出的照片來源資訊，方便讀者查找。</p>
      <ul class="mt-10 grid gap-4 md:grid-cols-2">
        {photoCredits.map((credit) => (
          <li class="detail-card">
            <h2 class="text-lg font-bold text-forest-900">{credit.label}</h2>
            <p class="mt-3 text-sm leading-7 text-stonewarm-700">攝影者：{credit.author}<br />原始來源標示：{credit.license}</p>
            <a class="mt-4 inline-block font-bold text-forest-800 underline underline-offset-4" href={credit.source} target="_blank" rel="noopener noreferrer">查看照片原始來源 ↗</a>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-sm leading-7 text-stonewarm-700">如需查核景點資訊、地圖與評價，請參閱<a href="/sources/" class="font-bold text-forest-800 underline underline-offset-4">資料來源與更新說明</a>。</p>
    </div>
  </section>
</SubpageLayout>
