---
import SubpageLayout from '@/layouts/SubpageLayout.astro';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import { places } from '@/data/places';
const breadcrumb = [{ name: '周邊探索', path: '/explore/' }];
---
<SubpageLayout title="角板山周邊探索｜羅浮、小烏來與溪口景點指南" description="角板山周邊17個景點與停車入口指南：行館、梅園、新溪口吊橋、義興吊橋、羅浮橋、泰雅故事公園、小烏來天空步道與溪口台地。" canonical="https://jiaobanshanpark.com/explore/" {breadcrumb}>
  <section class="bg-forest-950 pt-[calc(var(--header-height)+5rem)] pb-20 text-white"><div class="container-shell"><p class="eyebrow text-plum-200">EXPLORE JIAOBANSHAN</p><h1 class="mt-4 font-serif text-4xl font-bold md:text-6xl">角板山周邊探索</h1><p class="mt-6 max-w-2xl text-lg leading-9">從角板山行館走向溪口、羅浮與小烏來，探索 {places.length} 個山城文化、溪谷步道及停車據點。</p></div></section>
  <section class="section-pad bg-cream-50"><div class="container-shell"><div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">{places.map(place => <article class="overflow-hidden rounded-3xl border border-forest-900/10 bg-white shadow-sm"><a href={`/explore/${place.slug}/`} aria-label={`閱讀${place.name}指南`}>{place.image ? (!place.image.startsWith('jiaobanshan-park-') ? <img src={`/images/${place.image}.jpg`} alt={place.photo} width="960" height="720" loading="lazy" class="aspect-[4/3] w-full object-cover" /> : <ResponsiveImage name={place.image} alt={place.photo} width={960} height={720} class="aspect-[4/3] w-full object-cover" sizes="(min-width: 1024px) 33vw, 90vw" />) : <div class="flex aspect-[4/3] items-center justify-center bg-forest-900 p-8 text-center font-serif text-2xl font-bold text-cream-100">{place.name}<span class="sr-only">專屬照片補充中</span></div>}</a><div class="p-6"><p class="eyebrow">{place.type}</p><h2 class="mt-2 font-serif text-2xl font-bold">{place.name}</h2><p class="mt-3 text-sm leading-7 text-stonewarm-700">{place.lead}</p><a href={`/explore/${place.slug}/`} class="mt-5 inline-block font-bold text-forest-800 underline">閱讀完整指南 →</a></div></article>)}</div></div></section>
</SubpageLayout>
