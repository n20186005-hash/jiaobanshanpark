---
import SubpageLayout from '@/layouts/SubpageLayout.astro';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import { places } from '@/data/places';

export function getStaticPaths() {
  return places.map((place) => ({ params: { slug: place.slug }, props: { place } }));
}
const { place } = Astro.props;
const path = `/explore/${place.slug}/`;
const canonical = `https://jiaobanshanpark.com${path}`;
const title = `${place.name}｜位置、特色、交通與遊覽路線`;
const description = `${place.name}旅遊指南：${place.lead}整理地址、開放資訊、費用、歷史特色、拍照建議與 Google 地圖導航。`;
const breadcrumb = [{ name: '周邊探索', path: '/explore/' }, { name: place.name, path }];
const schema = {
  '@context': 'https://schema.org', '@type': place.slug.includes('parking') ? 'ParkingFacility' : 'TouristAttraction', name: place.name, description,
  url: canonical, ...(place.image ? { image: `https://jiaobanshanpark.com/images/${place.image}.jpg` } : {}),
  isPartOf: { '@type': 'TouristAttraction', name: '角板山公園', url: 'https://jiaobanshanpark.com/' },
  hasMap: place.map,
};
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: '首頁', item: 'https://jiaobanshanpark.com/' },
  { '@type': 'ListItem', position: 2, name: '周邊探索', item: 'https://jiaobanshanpark.com/explore/' },
  { '@type': 'ListItem', position: 3, name: place.name, item: canonical },
] };
const extraImage = ({'jiaobanshan-residence':'jiaobanshan-park-grounds-1','war-tunnel':'jiaobanshan-park-tunnel-1','camphor-storehouse':'jiaobanshan-park-entrance-1','sichin-pavilion':'jiaobanshan-park-plum-1'} as Record<string,string>)[place.slug];
const originalJpg = !place.image.startsWith('jiaobanshan-park-');
---
<SubpageLayout {title} {description} {canonical} {breadcrumb}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  </Fragment>
  <section class="relative overflow-hidden bg-forest-950 pt-[calc(var(--header-height)+3rem)] text-white">
    <div class="absolute inset-0">{place.image && (originalJpg ? <img src={`/images/${place.image}.jpg`} alt={place.photo} width="960" height="720" class="h-full w-full object-cover" fetchpriority="high" /> : <ResponsiveImage name={place.image} alt={place.photo} width={960} height={720} class="h-full w-full object-cover" sizes="100vw" loading="eager" />)}<div class="hero-mask absolute inset-0"></div></div>
    <div class="container-shell relative max-w-4xl py-20 md:py-28">
      <p class="eyebrow text-plum-200">JIAOBANSHAN · {place.type}</p>
      <h1 class="mt-4 font-serif text-4xl font-bold md:text-6xl">{place.name}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-9 text-cream-100">{place.lead}</p>
      <p class="mt-5 text-sm font-semibold text-cream-200">{place.address} · {place.hours}</p>
      <a href={place.map} target="_blank" rel="nofollow noopener" class="mt-8 inline-flex rounded-full bg-white px-6 py-3 font-bold text-forest-900 hover:bg-cream-100">在 Google 地圖查看專屬位置 ↗</a>
    </div>
  </section>
  <section class="section-pad bg-cream-50" id="about-management"><div class="container-shell grid gap-10 lg:grid-cols-[.85fr_1.15fr]">
    <div><p class="eyebrow">ABOUT & MANAGEMENT</p><h2 class="section-title">關於{place.name}</h2><p class="mt-5 text-sm font-bold text-plum-700">管理主體與地方背景</p></div>
    <div><p class="section-lead">{place.management}</p><a class="mt-6 inline-block font-bold text-forest-800 underline" href="https://www.scenic.tycg.gov.tw/cp.aspx?n=9507" target="_blank" rel="noopener">桃園市政府風景區管理處官方介紹 ↗</a></div>
  </div></section>
  <section class="section-pad bg-forest-50"><div class="container-shell grid gap-10 lg:grid-cols-[.85fr_1.15fr]">
    <div><p class="eyebrow">PLAN YOUR VISIT</p><h2 class="section-title">基本資料與出發前資訊</h2><p class="section-lead mt-5">{place.lead}</p></div>
    <dl class="grid gap-4 sm:grid-cols-2">
      {([['所在地',place.address],['建議停留',place.duration],['開放資訊',place.hours],['門票或停車費',place.fee]] as const).map(([label,value]) => <div class="detail-card"><dt class="text-sm font-bold text-plum-700">{label}</dt><dd class="mt-2 leading-7 text-forest-900">{value}</dd></div>)}
    </dl>
  </div></section>
  <section class="section-pad bg-cream-50"><div class="container-shell grid gap-10 lg:grid-cols-[.85fr_1.15fr]"><div><p class="eyebrow">HISTORY & CULTURE</p><h2 class="section-title">歷史與地方脈絡</h2></div><p class="section-lead">{place.history}</p></div></section>
  <section class="section-pad bg-forest-50"><div class="container-shell grid gap-10 lg:grid-cols-[.85fr_1.15fr]"><div><p class="eyebrow">HIGHLIGHTS</p><h2 class="section-title">值得留意的三個特色</h2></div><div><p class="section-lead">{place.feature}</p><ul class="mt-6 grid gap-4">{place.highlights.map((item,index)=><li class="detail-card flex items-start gap-4"><span class="font-serif text-2xl font-bold text-plum-600">{index+1}</span><p class="leading-8">{item}</p></li>)}</ul></div></div></section>
  <section class="section-pad bg-forest-50"><div class="container-shell grid gap-10 lg:grid-cols-[.85fr_1.15fr]"><div><p class="eyebrow">WALKING ROUTE</p><h2 class="section-title">建議步行順序</h2><p class="section-lead mt-5">先確認山區天候與園區維護情況，再依步道指標調整。</p></div><ol class="space-y-4">{place.route.map((step,index) => <li class="detail-card flex gap-4"><span class="font-serif text-2xl font-bold text-plum-600">{String(index+1).padStart(2,'0')}</span><span class="leading-8">{step}</span></li>)}</ol></div></section>
  <section class="section-pad bg-cream-50"><div class="container-shell grid gap-10 lg:grid-cols-[.85fr_1.15fr]"><div><p class="eyebrow">PHOTOGRAPHY & GALLERY</p><h2 class="section-title">實景照片與拍攝機位</h2><p class="section-lead mt-5">{place.photo}。</p></div><div><div class="grid gap-4 sm:grid-cols-2">{place.image ? <figure class="overflow-hidden rounded-2xl bg-white">{originalJpg ? <img src={`/images/${place.image}.jpg`} alt={place.photo} width="960" height="720" loading="lazy" class="aspect-[4/3] w-full object-cover" /> : <ResponsiveImage name={place.image} alt={place.photo} width={960} height={720} class="aspect-[4/3] w-full object-cover" />}<figcaption class="p-3 text-xs text-stonewarm-600">{place.photo}</figcaption></figure> : <div class="rounded-2xl border border-forest-900/10 bg-white p-8 text-sm leading-8 text-stonewarm-700">此景點的專屬照片正在補充中。可先由<a href={place.map} class="font-bold text-forest-800 underline" target="_blank" rel="noopener">Google 地圖景點搜尋</a>查看現場影像。</div>}{extraImage && <figure class="overflow-hidden rounded-2xl bg-white"><ResponsiveImage name={extraImage} alt="角板山行館園區相關實景與周邊步道" width={960} height={720} class="aspect-[4/3] w-full object-cover"/><figcaption class="p-3 text-xs text-stonewarm-600">相鄰園區景觀，供規劃步行路線參考</figcaption></figure>}</div><ul class="mt-6 space-y-3">{place.photoSpots.map(spot=><li class="text-sm leading-8 text-stonewarm-700">• {spot}</li>)}</ul>{place.slug === 'shangtaidi-parking' && <a class="mt-3 inline-block text-sm underline" href="https://swh6487sws6487.pixnet.net/blog/posts/9576105916" target="_blank" rel="noopener">停車區照片來源</a>}{place.slug === 'renai-parking' && <a class="mt-3 inline-block text-sm underline" href="https://paicj.pixnet.net/blog/posts/11403711169" target="_blank" rel="noopener">停車入口照片來源</a>}{['ecological-pond','sculpture-garden','jiaobanshan-market','xinkou-bridge'].includes(place.slug) && <a class="mt-3 inline-block text-sm underline" href="https://travel.tycg.gov.tw/" target="_blank" rel="noopener">照片來源：桃園觀光導覽網</a>}</div></div></section>
  <section class="section-pad bg-forest-50"><div class="container-shell grid gap-10 lg:grid-cols-[.85fr_1.15fr]"><div><p class="eyebrow">BEFORE YOU GO</p><h2 class="section-title">游覽須知與住宿建議</h2></div><div><ul class="grid gap-4">{place.tips.map(tip=><li class="detail-card leading-8">{tip}</li>)}</ul><h3 class="mt-9 text-xl font-bold text-forest-900">住在哪裡較順路？</h3><p class="section-lead mt-3">{place.lodging}</p></div></div></section>
  <section class="section-pad bg-cream-50"><div class="container-shell grid gap-10 lg:grid-cols-[.85fr_1.15fr]"><div><p class="eyebrow">GETTING THERE</p><h2 class="section-title">交通指南與專屬導航</h2></div><div><p class="section-lead">自駕由大溪方向接台7線進入復興區，再依{place.name}的專屬地圖搜尋結果選擇正確道路與入口。{['yixing-suspension-bridge','luofu-bridge','atayal-story-park','losin-watan-park','xiaowulai-skywalk','xikou-terrace'].includes(place.slug) ? '羅浮、小烏來及溪口各有不同聯絡道路，不能直接以角板山公園入口導航；大眾運輸請先查詢復興區各站點班次與末班車。' : '搭公車可查詢角板山公園或復興站周邊路線，山區末班車需提前確認。'}</p><p class="mt-5 text-sm font-bold">所在地：{place.address}</p><a class="mt-5 inline-flex rounded-full bg-forest-900 px-6 py-3 font-bold text-white" href={place.map} target="_blank" rel="nofollow noopener">開啟{place.name} Google 地圖 ↗</a><p class="mt-4 text-sm text-stonewarm-600">此為該地點名稱的專屬搜尋連結；地圖可能提供多個候選結果，請核對名稱與入口。</p></div></div></section>
  <section class="section-pad bg-forest-50"><div class="container-shell grid gap-10 lg:grid-cols-[.85fr_1.15fr]"><div><p class="eyebrow">REVIEWS & FAQ</p><h2 class="section-title">遊客評價與常見問答</h2><p class="section-lead mt-5">查看 Google 地圖上的最新公開評價；本站不虛構未核實的分數及評論數。</p><a class="mt-5 inline-block font-bold text-forest-800 underline" href={place.map} target="_blank" rel="nofollow noopener">在 Google 地圖查看評價 ↗</a></div><div>{place.faqs.map(faq=><details class="faq-item py-5"><summary class="cursor-pointer font-bold text-forest-900">{faq.q}</summary><p class="mt-3 leading-8 text-stonewarm-700">{faq.a}</p></details>)}<p class="mt-8 text-sm leading-7 text-stonewarm-600">資料來源：<a class="underline" href="https://www.scenic.tycg.gov.tw/cp.aspx?n=9507" target="_blank" rel="noopener">桃園市政府風景區管理處</a>、<a class="underline" href="https://travel.tycg.gov.tw/zh-tw/travel/tour/48" target="_blank" rel="noopener">桃園觀光導覽網</a>。開放、票價與交通資訊出發前請現場核實。</p></div></div></section>
  <section class="section-pad bg-cream-100"><div class="container-shell"><p class="eyebrow">KEEP EXPLORING</p><h2 class="section-title">接著探索角板山</h2><div class="mt-8 grid gap-4 md:grid-cols-3">{places.filter(p => p.slug !== place.slug).slice(0,3).map(p => <a class="detail-card transition hover:-translate-y-1" href={`/explore/${p.slug}/`}><span class="text-xs font-bold text-plum-700">{p.type}</span><h3 class="mt-2 text-xl font-bold text-forest-900">{p.name} →</h3><p class="mt-2 text-sm leading-7">{p.lead}</p></a>)}</div><a class="mt-8 inline-block font-bold text-forest-800 underline" href="/explore/">查看全部景點與停車資訊</a></div></section>
</SubpageLayout>
