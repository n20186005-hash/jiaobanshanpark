---
type IconName =
  | 'map-pin'
  | 'clock'
  | 'ticket'
  | 'mountain'
  | 'arrow-right'
  | 'route'
  | 'car'
  | 'bus'
  | 'accessibility'
  | 'child'
  | 'umbrella'
  | 'camera'
  | 'leaf'
  | 'info'
  | 'menu'
  | 'close'
  | 'chevron-down'
  | 'external'
  | 'phone';

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = 'size-5', strokeWidth = 1.8 } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'map-pin' && <><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></>}
  {name === 'ticket' && <><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h13A2.5 2.5 0 0 1 21 7.5V9a3 3 0 0 0 0 6v1.5a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 16.5V15a3 3 0 0 0 0-6V7.5Z"/><path d="M12 7v10" stroke-dasharray="2 2"/></>}
  {name === 'mountain' && <><path d="m3 19 6.5-10 3.2 4.4L16 8l5 11H3Z"/><path d="m8.2 11 1.3 1.5 1.2-1.3"/></>}
  {name === 'arrow-right' && <><path d="M5 12h14"/><path d="m14 7 5 5-5 5"/></>}
  {name === 'route' && <><circle cx="6" cy="18" r="2"/><circle cx="18" cy="6" r="2"/><path d="M8 18h3a3 3 0 0 0 3-3V9a3 3 0 0 1 3-3"/></>}
  {name === 'car' && <><path d="m5 11 1.5-4h11l1.5 4"/><path d="M4 11h16v6H4z"/><circle cx="7" cy="17" r="1.5"/><circle cx="17" cy="17" r="1.5"/></>}
  {name === 'bus' && <><rect x="5" y="3" width="14" height="16" rx="3"/><path d="M5 10h14M8 6h8"/><circle cx="8" cy="16" r="1" fill="currentColor"/><circle cx="16" cy="16" r="1" fill="currentColor"/><path d="m7 19-1 2m11-2 1 2"/></>}
  {name === 'accessibility' && <><circle cx="12" cy="4" r="2"/><path d="M10 8h4l2 5h3M11 8l-1 5-3 4M9 14a5 5 0 1 0 8 4"/></>}
  {name === 'child' && <><circle cx="12" cy="5" r="2"/><path d="M7 11c1.6-2 3.2-3 5-3s3.4 1 5 3M9 11l1 4-2 5m7-9-1 4 2 5M10 15h4"/></>}
  {name === 'umbrella' && <><path d="M4 12a8 8 0 0 1 16 0c-1.3-1.2-2.7-1.2-4 0-1.3-1.2-2.7-1.2-4 0-1.3-1.2-2.7-1.2-4 0-1.3-1.2-2.7-1.2-4 0Z"/><path d="M12 12v6a2 2 0 0 0 4 0"/></>}
  {name === 'camera' && <><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3"/></>}
  {name === 'leaf' && <><path d="M20 4C12 4 6 8 5 16c5 1 11-1 15-12Z"/><path d="M5 20c2-5 6-8 11-11"/></>}
  {name === 'info' && <><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></>}
  {name === 'menu' && <><path d="M4 7h16M4 12h16M4 17h16"/></>}
  {name === 'close' && <><path d="m6 6 12 12M18 6 6 18"/></>}
  {name === 'chevron-down' && <path d="m7 10 5 5 5-5"/>}
  {name === 'external' && <><path d="M14 5h5v5M19 5l-8 8"/><path d="M18 13v5H6V6h5"/></>}
  {name === 'phone' && <path d="M7 4h3l1.5 4-2 1.5a14 14 0 0 0 5 5L16 12.5l4 1.5v3c0 1.1-.9 2-2 2C10.8 19 5 13.2 5 6c0-1.1.9-2 2-2Z"/>}
</svg>
