  {name === 'cart' && <><circle cx="9" cy="20" r="1.5"/><circle cx="17" cy="20" r="1.5"/><path d="M3 4h2l2.4 11h10.2L20 7H6.5"/></>}
  {name === 'fuel' && <><path d="M5 21V5a2 2 0 0 1 2-2h5a2 2 0 0 1 2 2v16"/><path d="M4 21h10"/><path d="M14 9h3a2 2 0 0 1 2 2v8a2 2 0 0 0 2 2 2 2 0 0 0 2-2v-6l-3-3"/></>}
  {name === 'wifi' && <><path d="M2 8.5a16 16 0 0 1 20 0"/><path d="M5 12a11 11 0 0 1 14 0"/><path d="M8.5 15.5a6 6 0 0 1 7 0"/><circle cx="12" cy="19" r="1" fill="currentColor"/></>}
  {name === 'compass' && <><circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5 5-2Z" fill="currentColor" stroke="none"/></>}
  {name === 'shield' && <path d="M12 3l7 3v5c0 4.6-3 8-7 10-4-2-7-5.4-7-10V6l7-3Z" />}
  {name === 'book-open' && <path d="M12 6c-2-1.5-5-1.5-7 0v12c2-1.5 5-1.5 7 0M12 6c2-1.5 5-1.5 7 0v12c-2-1.5-5-1.5-7 0" />}
  {name === 'sparkles' && <><path d="M12 3l1.4 4.6L18 9l-4.6 1.4L12 15l-1.4-4.6L6 9l4.6-1.4L12 3Z"/><path d="M18.5 14l.8 2.2L21.5 17l-2.2.8L18.5 20l-.8-2.2L15.5 17l2.2-.8L18.5 14Z"/></>}
  {name === 'droplet' && <path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z" />}
  {name === 'wind' && <path d="M3 8h11a2.5 2.5 0 1 0-2.5-2.5M3 12h15a2.5 2.5 0 1 1-2.5 2.5M3 16h9a2.5 2.5 0 1 1-2.5 2.5" />}
  {name === 'footprints' && <><path d="M6 4c1.6 0 2 3 2 5s-.6 6-2 6-2-3-2-5 .4-6 2-6ZM6 16c1 0 1.5 2 1.5 3s-1 2-2 2-1.5-1-1.5-2 1-3 2-3ZM18 4c1.6 0 2 3 2 5s-.6 6-2 6-2-3-2-5 .4-6 2-6ZM18 16c1 0 1.5 2 1.5 3s-1 2-2 2-1.5-1-1.5-2 1-3 2-3Z"/></>}
  {name === 'recycle' && <><path d="M7 19l-2-3.5A8 8 0 0 1 17 6.5"/><path d="M17 5l2 1.5A8 8 0 0 1 7 17.5"/><path d="M7 19h3M17 5v3"/></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"/></>}
  {name === 'cloud-sun' && <><circle cx="7" cy="7" r="2.5"/><path d="M7 9.5A5 5 0 0 1 16 11a3.5 3.5 0 1 1 0 7H8a4 4 0 0 1-1-8Z"/></>}
  {name === 'cloud' && <path d="M7 18a4 4 0 1 1 .5-7.9A5 5 0 0 1 17 11a3.5 3.5 0 1 1 0 7H7Z" />}
  {name === 'cloud-rain' && <><path d="M7 15a4 4 0 1 1 .5-7.9A5 5 0 0 1 17 8a3.5 3.5 0 1 1 0 7H7Z"/><path d="M8 18l-1 2M12 18l-1 2M16 18l-1 2"/></>}
  {name === 'cloud-snow' && <><path d="M7 14a4 4 0 1 1 .5-7.9A5 5 0 0 1 17 7a3.5 3.5 0 1 1 0 7H7Z"/><path d="M9 18h.01M12 19h.01M15 18h.01"/></>}
</svg>
